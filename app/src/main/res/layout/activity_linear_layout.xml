<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/light_gray"
    android:gravity="center_horizontal">

    <!-- 1. TextView — Заголовок -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/linear_layout_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/purple_700"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="16dp" />

    <!-- 2. ImageView -->
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/ic_dialog_info"
        android:contentDescription="@string/tv_image_desc"
        android:paddingBottom="16dp" />

    <!-- 3. TextView — Приветствие -->
    <TextView
        android:id="@+id/tvHello"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tv_hello"
        android:textSize="18sp"
        android:textColor="@color/dark_gray"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <!-- 4. EditText -->
    <EditText
        android:id="@+id/etInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/et_input"
        android:inputType="text"
        android:backgroundTint="@color/teal_700"
        android:padding="12dp"
        android:paddingBottom="12dp" />

    <!-- 5. Button -->
    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_submit"
        android:backgroundTint="@color/teal_700"
        android:paddingBottom="8dp" />

    <!-- 6. TextView — Результат -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tv_result"
        android:textSize="16sp"
        android:textColor="@color/green"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <!-- 7. Counter row: Button + TextView + Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/light_blue"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnDecrement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_decrement"
            android:backgroundTint="@color/red"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/tvCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tv_counter"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/btnIncrement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_increment"
            android:backgroundTint="@color/green" />
    </LinearLayout>

    <!-- 8. ProgressBar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="60"
        android:max="100"
        android:progressTint="@color/orange"
        android:paddingBottom="12dp" />

    <!-- 9. CheckBox -->
    <CheckBox
        android:id="@+id/cbAccept"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_checkbox_label"
        android:textColor="@color/dark_gray" />

    <!-- 10. Switch -->
    <Switch
        android:id="@+id/switchNotif"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_switch_label"
        android:thumbTint="@color/teal_700"
        android:trackTint="@color/purple_200"
        android:paddingTop="12dp"
        android:paddingBottom="24dp" />

</LinearLayout>
